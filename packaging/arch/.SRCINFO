pkgbase = liuguang
	pkgdesc = Linux 动态壁纸（桌面 Wayland 壁纸层 / 无头 DRM-KMS）
	pkgver = 0.3.1
	pkgrel = 1
	url = https://github.com/suluoMISS/liuguang
	install = liuguang.install
	arch = x86_64
	arch = aarch64
	license = MIT
	makedepends = cargo
	makedepends = rust
	makedepends = pkgconf
	makedepends = libdrm
	makedepends = libva
	makedepends = ffmpeg
	makedepends = gstreamer
	makedepends = wayland
	depends = wayland
	depends = libdrm
	depends = gstreamer
	depends = gst-plugins-base
	depends = gst-plugins-good
	depends = gst-libav
	depends = ffmpeg
	depends = libva
	optdepends = gst-plugin-va: GStreamer 的 VA-API 硬解（仅在零拷贝不可用时的回退路径上才需要）
	optdepends = intel-media-driver: Intel 核显的 VA-API 驱动（iHD）
	optdepends = libva-nvidia-driver: NVIDIA 的 VA-API 驱动（NVDEC）
	options = !lto

pkgname = liuguang
